{
  "name": "@densa/core",
  "version": "0.0.0",
  "private": true,
  "description": "Editor-independent authoritative runtime for Densa projects.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./persistence": {
      "types": "./dist/persistence/index.d.ts",
      "default": "./dist/persistence/index.js"
    },
    "./daemon": {
      "types": "./dist/daemon.d.ts",
      "default": "./dist/daemon.js"
    },
    "./daemon-bin": {
      "types": "./dist/daemon-bin.d.ts",
      "default": "./dist/daemon-bin.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@densa/agent-sdk": "0.0.0",
    "@densa/protocol": "0.0.0",
    "playwright": "1.62.1"
  }
}
